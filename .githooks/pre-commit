#!/usr/bin/env bash
# auto-fixes clang-tidy warnings and clang-formats staged c/c++ files under
# src/ and tests/, then re-stages them.
set -euo pipefail

formatter="${CLANG_FORMAT:-clang-format}"
llvm_bin="${LLVM_BIN:-/opt/homebrew/opt/llvm/bin}"

if ! command -v "$formatter" >/dev/null 2>&1; then
    echo "pre-commit: clang-format was not found. Install it or set CLANG_FORMAT." >&2
    exit 1
fi

staged=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx) staged+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- src tests)

[ ${#staged[@]} -eq 0 ] && exit 0

# clang-tidy fixes land in the headers the staged sources include too.
# ponytail: a header fixed through a staged .cpp but not itself staged stays as an unstaged change.
if ! scripts/tidy-fix.sh "${staged[@]}"; then
    echo "pre-commit: commit aborted." >&2
    exit 1
fi

# ponytail: formats and re-adds whole files, so a partially staged file gets its unstaged hunks committed too.
for file in "${staged[@]}"; do
    "$formatter" -i --style=file "$file"
    git add -- "$file"
done
